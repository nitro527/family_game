{
  "Entries": [
    { "Id": "intro", "Lines": [
      { "Text": "옛날 옛적, 별빛 마을에 꼬마 마법사 {name:이/가} 살았어요.", "Face": "smile" },
      { "Text": "어느 밤, 성에 사는 킹 젤리가 밤하늘의 별빛을 몽땅 훔쳐 갔어요!", "Face": "surprised" },
      { "Text": "{name:은/는} 별 지팡이를 꼭 쥐고 성으로 떠났어요. 가자!", "Face": "cast" } ] },
    { "Id": "sign", "Lines": [
      { "Text": "표지판: \"킹 젤리의 성은 길을 따라 남동쪽! 풀숲에는 젤리들이 숨어 있어요.\"", "Face": "smile" } ] },
    { "Id": "fountain", "Lines": [
      { "Text": "반짝이는 샘물을 마셨다! HP와 MP가 모두 회복되고, 사탕도 가득 채웠다!", "Face": "laugh" } ] },
    { "Id": "boss_gate", "Lines": [
      { "Text": "성문 앞에 거대한 그림자가… 킹 젤리다!", "Face": "surprised" } ] },

    { "Id": "appear",       "Lines": [ { "Text": "{enemy:이/가} 나타났다!", "Face": "surprised", "Hold": 1.1 } ] },
    { "Id": "fire_cast",    "Lines": [ { "Text": "{name}의 {skill}!", "Face": "cast", "Hold": 0.45 } ] },
    { "Id": "fire_miss",    "Lines": [ { "Text": "앗, 빗나갔다!", "Face": "pout", "Hold": 0.9 } ] },
    { "Id": "fire_hit",     "Lines": [ { "Text": "{enemy}에게 {dmg}의 피해!", "Face": "cast", "Hold": 0.8 } ] },
    { "Id": "star_cast",    "Lines": [ { "Text": "{name}의 필살 주문…", "Face": "cast", "Hold": 0.55 } ] },
    { "Id": "star_hit",     "Lines": [ { "Text": "별빛이 쏟아진다! {enemy}에게 {dmg}의 피해!", "Face": "laugh", "Hold": 1.0 } ] },
    { "Id": "candy",        "Lines": [ { "Text": "달콤한 사탕을 먹었다! HP가 {heal} 회복되었다.", "Face": "laugh", "Hold": 1.0 } ] },
    { "Id": "run_ok",       "Lines": [ { "Text": "{name:은/는} 재빨리 도망쳤다!", "Face": "surprised", "Hold": 0.9 } ] },
    { "Id": "run_fail",     "Lines": [ { "Text": "도망치지 못했다!", "Face": "pout", "Hold": 0.9 } ] },
    { "Id": "enemy_attack", "Lines": [ { "Text": "{enemy}의 공격!", "Face": "surprised", "Hold": 0.5 } ] },
    { "Id": "dodge",        "Lines": [ { "Text": "{name:은/는} 살짝 피했다!", "Face": "laugh", "Hold": 0.8 } ] },
    { "Id": "hurt",         "Lines": [ { "Text": "{name:은/는} {dmg}의 피해를 입었다!", "Face": "cry", "Hold": 0.9 } ] },
    { "Id": "win",          "Lines": [ { "Text": "{enemy:을/를} 물리쳤다!", "Face": "laugh", "Hold": 1.0 } ] },
    { "Id": "exp",          "Lines": [ { "Text": "경험치 {exp}을(를) 얻었다!", "Face": "laugh", "Hold": 0.8 } ] },
    { "Id": "levelup",      "Lines": [ { "Text": "레벨이 올랐다! {name}의 레벨이 {lv}이(가) 되었다! 힘이 넘친다!", "Face": "laugh", "Hold": 1.5 } ] },
    { "Id": "defeat", "Lines": [
      { "Text": "{name:은/는} 쓰러지고 말았다…", "Face": "cry", "Hold": 1.4 },
      { "Text": "…그때, 멀리서 엄마 아빠의 응원 소리가 들렸다! 힘을 내!", "Face": "surprised", "Hold": 1.6 } ] },
    { "Id": "revive",       "Lines": [ { "Text": "{name:은/는} 샘물 곁에서 다시 일어났다!", "Face": "laugh", "Hold": 1.3 } ] },

    { "Id": "ending_light", "Lines": [ { "Text": "킹 젤리가 품고 있던 별빛이 밤하늘로 돌아간다…!", "Face": "surprised", "Hold": 1.5 } ] },
    { "Id": "ending_card",  "Lines": [ { "Text": "꼬마 마법사 <color=#F2C443>{name}</color>의 활약으로\n밤하늘에 별빛이 다시 반짝이기 시작했어요!\n\n최종 레벨 {lv}\n<color=#F2C443>'별빛 마법사'</color>의 칭호를 얻었다!" } ] }
  ]
}
